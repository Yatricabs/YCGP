#!/bin/sh

##############################################################################
# Gradle startup script for POSIX environments.
# The Gradle Wrapper JAR is generated by `gradle wrapper` and is intentionally
# kept alongside gradle-wrapper.properties in source control for normal use.
##############################################################################

set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -n "${JAVA_HOME:-}" ]; then
  JAVA_EXE="$JAVA_HOME/bin/java"
else
  JAVA_EXE="$(command -v java || true)"
fi

if [ -z "$JAVA_EXE" ] || [ ! -x "$JAVA_EXE" ]; then
  echo "ERROR: JAVA_HOME is not set and no usable java command was found." >&2
  exit 1
fi

WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "ERROR: Gradle Wrapper JAR is missing:" >&2
  echo "  $WRAPPER_JAR" >&2
  echo "Generate it with: gradle wrapper --gradle-version 8.12" >&2
  exit 1
fi

exec "$JAVA_EXE" ${DEFAULT_JVM_OPTS:-} ${JAVA_OPTS:-} ${GRADLE_OPTS:-} \
  -Dorg.gradle.appname="$(basename "$0")" \
  -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
